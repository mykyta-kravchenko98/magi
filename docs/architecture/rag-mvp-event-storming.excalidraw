      "updated": 1786441903715,
      "link": null,
      "locked": false,
      "text": "ID:\n- ingestion_id\n\nInput snapshot:\n- knowledge_base_id\n- document_id\n- document_version_id\n- normalized_content_artifact_id\n\nProcessing configuration:\n- chunking_profile_id\n- embedding_model_id\n- embedding_model_version\n\nArtifacts:\n- chunk_manifest_id?\n- embedding_manifest_id?\n- retrieval_projection_id?\n\nExecution:\n- status\n- chunking_attempts\n- embedding_attempts\n- reconciliation_attempts\n- next_retry_at?\n- stage_deadline_at?\n- last_error_code?\n- created_at\n- updated_at\n- aggregate_version",
      "fontSize": 21.29815619063011,
