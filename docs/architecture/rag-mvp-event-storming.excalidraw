      "boundElements": [],
      "updated": 1786442019867,
      "link": null,
      "locked": false,
      "text": "PENDING → CHUNKING\nCHUNKING → EMBEDDING\nEMBEDDING → WAITING_FOR_RETRIEVAL\nWAITING_FOR_RETRIEVAL → COMPLETED\nany non-terminal state → FAILED",
      "fontSize": 19.17319116520545,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PENDING → CHUNKING\nCHUNKING → EMBEDDING\nEMBEDDING → WAITING_FOR_RETRIEVAL\nWAITING_FOR_RETRIEVAL → COMPLETED\nany non-terminal state → FAILED",
      "autoResize": true,
      "lineHeight": 1.25
    },
