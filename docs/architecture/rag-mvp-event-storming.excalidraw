      "updated": 1786443654937,
      "link": null,
      "locked": false,
      "text": "PENDING → INDEXING\nINDEXING → INDEXED\nINDEXED → ACTIVATING\nACTIVATING → ACTIVE\nACTIVE → RETIRED\nRETIRED → DELETED\n\nINDEXING → FAILED\non Indexing Abandoned\n\nACTIVATING → FAILED\non Activation Abandoned",
      "fontSize": 18.245201132819705,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PENDING → INDEXING\nINDEXING → INDEXED\nINDEXED → ACTIVATING\nACTIVATING → ACTIVE\nACTIVE → RETIRED\nRETIRED → DELETED\n\nINDEXING → FAILED\non Indexing Abandoned\n\nACTIVATING → FAILED\non Activation Abandoned",
      "autoResize": true,
      "lineHeight": 1.25
    },
