MAGI_ENVIRONMENT=development
# Optional: load missing MAGI_* values from a JSON object in AWS Secrets Manager.
# Explicit environment variables in this file take precedence over secret values.
# MAGI_SECRETS_MANAGER_SECRET_ID=magi/production
# AWS_REGION=eu-central-1
MAGI_DOCS_ENABLED=true
MAGI_MAX_UPLOAD_BYTES=20971520
MAGI_CHUNK_TARGET_TOKENS=600
MAGI_CHUNK_SOFT_MAX_TOKENS=800
MAGI_CHUNK_HARD_MAX_TOKENS=1000
MAGI_CHUNK_OVERLAP_TOKENS=80
MAGI_EMBEDDING_INPUT_MAX_TOKENS=2048
# Generate local values before starting Compose; never commit the populated .env file.
POSTGRES_DB=magi
POSTGRES_USER=magi
POSTGRES_PASSWORD=replace-with-random-postgres-password
MINIO_ROOT_USER=magi
MINIO_ROOT_PASSWORD=replace-with-random-minio-password
QDRANT_API_KEY=replace-with-random-qdrant-api-key
MAGI_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
MAGI_DATABASE_POOL_SIZE=5
MAGI_DATABASE_POOL_TIMEOUT_SECONDS=5
MAGI_OBJECT_STORAGE_ENDPOINT=localhost:9000
MAGI_OBJECT_STORAGE_ACCESS_KEY=${MINIO_ROOT_USER}
MAGI_OBJECT_STORAGE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MAGI_OBJECT_STORAGE_BUCKET=magi-sources
MAGI_OBJECT_STORAGE_SECURE=false
MAGI_OBJECT_STORAGE_TIMEOUT_SECONDS=10
MAGI_EMBEDDING_BASE_URL=http://127.0.0.1:8081
MAGI_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
MAGI_EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
MAGI_EMBEDDING_VECTOR_DIMENSION=1024
MAGI_EMBEDDING_BATCH_SIZE=16
MAGI_EMBEDDING_TIMEOUT_SECONDS=30
MAGI_QDRANT_URL=http://127.0.0.1:6333
MAGI_QDRANT_COLLECTION=magi_knowledge_chunks_qwen3_06b_1024_token_v1
MAGI_QDRANT_VECTOR_DIMENSION=1024
MAGI_QDRANT_BATCH_SIZE=64
MAGI_QDRANT_TIMEOUT_SECONDS=10
MAGI_QDRANT_API_KEY=${QDRANT_API_KEY}
